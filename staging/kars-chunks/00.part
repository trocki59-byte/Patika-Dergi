    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sm\:text-\[56px\] {
    font-size: 56px;
  }
}

@media (min-width: 768px) {
  .md\:flex {
    display: flex;
  }

  .md\:hidden {
    display: none;
  }

  .md\:grid-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

